# DEV ONLY. Усі значення нижче - плейсхолдери для локального Docker-стеку.
# НЕ використовувати в staging/prod; реальні секрети в репозиторій не додавати.
# cp .env.example .env

# Host-порти (127.0.0.1), підібрані щоб не конфліктувати з іншими сервісами хоста
KAFKA_HOST_PORT=19092
POSTGRES_HOST_PORT=15432
CLICKHOUSE_HTTP_HOST_PORT=18124
CLICKHOUSE_NATIVE_HOST_PORT=19010
S3_HOST_PORT=19200

POSTGRES_USER=astryon
POSTGRES_PASSWORD=astryon_dev_only      # DEV-ONLY placeholder
POSTGRES_DB=astryon
CLICKHOUSE_USER=astryon
CLICKHOUSE_PASSWORD=astryon_dev_only    # DEV-ONLY placeholder
CLICKHOUSE_DB=astryon

# clickhouse-sink runs on the host (not in compose). Opt in to durable chunk boundaries (migration 0004):
# CHSINK_INTENT_TABLE=sink_chunk_intents

# AAS (external auth; see docs/architecture/authentication.md)
AAS_BASE_URL=
AAS_ISSUER=
AAS_ENV=prod
AAS_CLIENT_ID=astryon-dev-ingest
# Keep the PEM outside the repo, e.g. ~/.astryon-dev/astryon-dev-client.key.pem (chmod 600)
AAS_PRIVATE_KEY_FILE=
AAS_AUDIENCE=https://api.astryon.sv4.one
AAS_ALLOWED_AZP=astryon-dev-ingest
# typ claim of real AAS access tokens (default in code: at+jwt)
AAS_TOKEN_TYPE=Bearer
