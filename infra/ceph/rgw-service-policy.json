{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TenantScopedObjectAccess",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:AbortMultipartUpload"],
      "Resource": "arn:aws:s3:::astryon-files/${aws:PrincipalTag/tenant_id}/*"
    },
    {
      "Sid": "TenantScopedList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::astryon-files",
      "Condition": {"StringLike": {"s3:prefix": ["${aws:PrincipalTag/tenant_id}/*"]}}
    }
  ]
}
