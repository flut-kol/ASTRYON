{
  "title": "ASTRYON Platform Overview",
  "uid": "astryon-overview",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Gateway accepted events/s",
      "targets": [{"expr": "sum(rate(astryon_gateway_ack_total[5m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ops"}}
    },
    {
      "type": "timeseries",
      "title": "Gateway ACK error ratio",
      "targets": [{"expr": "astryon:gateway_ack_error_ratio:5m", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit"}}
    },
    {
      "type": "timeseries",
      "title": "Kafka consumer lag",
      "targets": [{"expr": "sum by (group, topic) (kafka_consumergroup_lag)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "type": "timeseries",
      "title": "ClickHouse free disk ratio",
      "targets": [{"expr": "node_filesystem_avail_bytes{mountpoint=\"/var/lib/clickhouse\"} / node_filesystem_size_bytes{mountpoint=\"/var/lib/clickhouse\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit"}}
    }
  ]
}
