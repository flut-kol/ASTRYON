{
 "uid": "pipeline-lag",
 "title": "ASTRYON Pipeline Lag",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "tags": [
  "astryon"
 ],
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Consumer lag",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag)",
     "legendFormat": "{{consumergroup}}/{{topic}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Sink consumed vs inserted /s",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(astryon_clickhouse_sink_consumed_total[1m]))",
     "legendFormat": "consumed"
    },
    {
     "refId": "B",
     "expr": "sum(rate(astryon_clickhouse_sink_inserted_rows_total[1m]))",
     "legendFormat": "inserted"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Quarantined /s",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(astryon_clickhouse_sink_quarantined_total[5m]))",
     "legendFormat": "quarantined"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Sink failures /s",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(astryon_clickhouse_sink_insert_failures_total[5m]))",
     "legendFormat": "insert"
    },
    {
     "refId": "B",
     "expr": "sum(rate(astryon_clickhouse_sink_commit_failures_total[5m]))",
     "legendFormat": "commit"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Sink buffered",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(astryon_clickhouse_sink_buffered)",
     "legendFormat": "buffered"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Kafka under-replicated",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(kafka_topic_partition_under_replicated_partition)",
     "legendFormat": "URP"
    }
   ]
  }
 ]
}