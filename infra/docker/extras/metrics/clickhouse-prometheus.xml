<!-- DEV ONLY: ClickHouse built-in Prometheus endpoint (/metrics on 9363). Mounted by extras/metrics/clickhouse-metrics.override.yml. -->
<clickhouse>
  <prometheus>
    <endpoint>/metrics</endpoint>
    <port>9363</port>
    <metrics>true</metrics>
    <events>true</events>
    <asynchronous_metrics>true</asynchronous_metrics>
  </prometheus>
</clickhouse>
