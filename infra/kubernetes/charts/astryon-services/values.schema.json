{
 "$schema": "https://json-schema.org/draft-07/schema#",
 "type": "object",
 "properties": {
  "services": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "properties": {
     "image": {
      "type": "object",
      "required": [
       "name",
       "digest"
      ],
      "properties": {
       "name": {
        "type": "string",
        "minLength": 1
       },
       "digest": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
       }
      }
     },
     "replicas": {
      "type": "integer",
      "minimum": 1
     },
     "probe": {
      "type": "object",
      "properties": {
       "type": {
        "enum": [
         "http",
         "tcp",
         "none"
        ]
       }
      }
     }
    }
   }
  }
 }
}